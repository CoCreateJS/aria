{
  "name": "@cocreate/aria",
  "version": "1.8.0",
  "description": "Orchestrate dynamic UI behavior and ARIA state with event-driven action chains, configured via HTML5 attributes or the JavaScript API.",
  "keywords": [
    "aria",
    "workflow",
    "orchestration",
    "automation",
    "chain-actions",
    "event-driven",
    "attributes",
    "dom",
    "low-code",
    "html5",
    "javascript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "Orchestrate dynamic UI behavior and ARIA state with event-driven action chains, configured via HTML5 attributes or the JavaScript API.",
      "source": "src/index.js",
      "declarative": {
        "selectors": [
          ":is([role=\"row\"][aria-selected])",
          "*",
          "[aria-controls]",
          "[aria-hidden]",
          "a[href]",
          "[aria-controls], [aria-pressed], [role=\"radio\"], [role=\"checkbox\"], [role=\"switch\"], :is([role=\"row\"][aria-selected]), :is([role=\"grid\"][aria-multiselectable=\"true\"] [role=\"row\"] input[type=\"checkbox\"])",
          "[aria-controls], [aria-pressed], [role=\"radio\"], [role=\"checkbox\"], [role=\"switch\"], [aria-selected], input[type=\"checkbox\"]"
        ],
        "attributes": [
          {
            "name": "aria-checked"
          },
          {
            "name": "aria-close"
          },
          {
            "name": "aria-close-on"
          },
          {
            "name": "aria-controls"
          },
          {
            "name": "aria-controls-class"
          },
          {
            "name": "aria-controls-group"
          },
          {
            "name": "aria-current"
          },
          {
            "name": "aria-default"
          },
          {
            "name": "aria-disabled"
          },
          {
            "name": "aria-expanded"
          },
          {
            "name": "aria-haspopup"
          },
          {
            "name": "aria-hidden"
          },
          {
            "name": "aria-open"
          },
          {
            "name": "aria-orientation"
          },
          {
            "name": "aria-pressed"
          },
          {
            "name": "aria-selected"
          },
          {
            "name": "disabled"
          },
          {
            "name": "hidden"
          },
          {
            "name": "href"
          },
          {
            "name": "role"
          },
          {
            "name": "state-id"
          },
          {
            "name": "state-localstorage"
          },
          {
            "name": "state-onstoragechange"
          },
          {
            "name": "tabindex"
          }
        ]
      },
      "api": {
        "exports": [
          "getControls",
          "init",
          "initElement",
          "setAriaCurrent",
          "syncAddedController",
          "syncControlledElement",
          "syncControlledElementState",
          "syncController"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocreatejs/CoCreate-aria.git"
  },
  "author": "CoCreate LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-aria/issues"
  },
  "homepage": "https://cocreate.app/docs/aria",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/observer": "^1.23.0",
    "@cocreate/state": "^1.29.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "allowScripts": {
    "@cocreate/observer@1.19.0": true,
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
  }
}
